<?xml version="1.0" encoding="utf-8"?>
<!-- Security audit: TLS only, no cleartext anywhere, no user-added CAs trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
