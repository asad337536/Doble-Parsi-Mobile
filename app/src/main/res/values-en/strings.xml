    <!-- Floating bubble -->
    <string name="section_bubble">Floating control</string>
    <string name="bubble_keep">Keep the bubble after a dub ends</string>
    <string name="bubble_keep_hint">It never disappears: start the next video\'s dub straight from the bubble.</string>
    <string name="bubble_timer">Show the dub time on the bubble</string>
    <string name="bubble_timer_hint">A mm:ss timer inside the floating control.</string>
    <string name="bubble_fade">Fade the bubble when idle</string>
    <string name="bubble_fade_hint">Dims down between sessions so it never covers the video.</string>
    <string name="bubble_collapse">Collapse into an edge tab when idle</string>
    <string name="bubble_collapse_hint">Shrinks to a slim tab at the screen edge; one touch brings it back.</string>
    <string name="bubble_snap">Auto-move to the closest edge</string>
    <string name="bubble_snap_hint">After a drag the bubble snaps to the nearest edge and stays on screen.</string>
    <string name="bubble_smart">Smart mode</string>
    <string name="bubble_smart_hint">Follows the session: wakes up full size when a dub starts and tidies itself away sooner when idle.</string>
    <string name="bubble_scale">Bubble size</string>
    <string name="bubble_tip">Tap: start/stop the dub · drag: move · long press: remove until the next start.</string>

